# umask, ulimits and the SUNK aliases/functions live in a POSIX file shared with bash.
# Ubuntu's /etc/zsh/zprofile does not source /etc/profile, so for zsh this is the
# only place SUNK_UMASK is applied.
. /usr/share/sunk/shellrc
